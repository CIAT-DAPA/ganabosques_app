# Variables de entorno para Docker
# Copiar este archivo a .env y configurar según sea necesario

# API Configuration
NEXT_PUBLIC_API_URL=https://ganaapi.alliance.cgiar.org/

# Keycloak Configuration (si es necesario)
NEXT_PUBLIC_KEYCLOAK_URL=https://your-keycloak-instance.com
NEXT_PUBLIC_KEYCLOAK_REALM=your-realm
NEXT_PUBLIC_KEYCLOAK_CLIENT_ID=your-client-id

# GeoServer Configuration
NEXT_PUBLIC_GEOSERVER_URL=https://your-geoserver-instance.com
